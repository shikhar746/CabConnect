# ---------- Core ----------
NODE_ENV=development
PORT=5000
# Local MongoDB (default). For Atlas: mongodb+srv://<user>:<password>@<cluster>/cabconnect
MONGODB_URI=mongodb://127.0.0.1:27017/cabconnect
# Dev fallback only: spin up a throwaway in-memory MongoDB (auto-seeded). Data is lost on restart.
USE_IN_MEMORY_DB=false
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
# Auth attempts per IP per 15 minutes (default: 30 in production, 200 otherwise)
AUTH_RATE_LIMIT=

# ---------- Business rules ----------
CURRENCY=INR
MATCH_RADIUS_KM=8
CANCELLATION_FREE_WINDOW_MIN=2
CANCELLATION_FEE=50
DRIVER_EARNING_SHARE=0.8
# Built-in GPS simulator moves the driver along the route (no device needed)
SIMULATE_DRIVER_MOVEMENT=true
SIMULATION_TICK_MS=2000

# ---------- Integrations: "mock" works out of the box ----------
# Payments: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY

# Maps / geocoding / routing: mock | google
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Social sign-in: mock | google
SOCIAL_AUTH_PROVIDER=mock
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Email receipts: mock | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM="CabConnect <no-reply@cabconnect.local>"

# SOS SMS: mock | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=REPLACE_WITH_TWILIO_NUMBER
